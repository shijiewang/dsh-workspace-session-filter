{
  "name": "dsh-workspace-session-filter",
  "version": "1.0.2",
  "description": "Workspace session filter panel with status and recency filters.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shijiewang/dsh-workspace-session-filter.git"
  },
  "homepage": "https://github.com/shijiewang/dsh-workspace-session-filter#readme",
  "bugs": {
    "url": "https://github.com/shijiewang/dsh-workspace-session-filter/issues"
  },
  "license": "MIT",
  "scripts": {
    "test": "node test/smoke.cjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session",
    "filter",
    "sidebar"
  ]
}
